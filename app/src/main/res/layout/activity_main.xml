<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/margen_pantalla">

        <ImageView
            android:layout_width="@dimen/tamano_logo"
            android:layout_height="@dimen/tamano_logo"
            android:contentDescription="@string/desc_logo"
            android:src="@drawable/ic_logo_cocina" />

        <TextView
            style="@style/Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name" />

        <TextView
            style="@style/TextoNormal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_eslogan" />

        <TextView
            android:id="@+id/tvSaludo"
            style="@style/TextoNormal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margen_entre_elementos" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/alto_foto"
            android:layout_marginTop="@dimen/margen_entre_elementos"
            android:contentDescription="@string/desc_foto"
            android:scaleType="centerCrop"
            android:src="@drawable/foto_plato" />

        <TextView
            style="@style/Titulo.Pequeno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margen_entre_elementos"
            android:text="@string/etiqueta_categoria" />

        <Spinner
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/categorias"
            android:minHeight="@dimen/alto_minimo_boton" />

        <Button
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margen_entre_elementos"
            android:text="@string/boton_ver_recetas" />

        <Button
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margen_entre_elementos"
            android:text="@string/boton_favoritos" />
    </LinearLayout>
</ScrollView>